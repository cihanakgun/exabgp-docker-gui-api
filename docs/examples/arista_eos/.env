# Web GUI credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# REST API token
ADMIN_TOKEN=supersecrettoken123

# Flask session secret — change this in production
FLASK_SECRET_KEY=change-this-secret-key

# ExaBGP socket path
EXABGP_SOCK=/opt/exabgp/run/exabgp.sock

# SQLite database path — lives in the shared volume, persists across restarts
DB_PATH=/opt/exabgp/run/routes.db

# How long to wait for BGP session to become Established before re-announcing (seconds)
BGP_WAIT_TIMEOUT=120

# How often to poll BGP session state while waiting (seconds)
BGP_POLL_INTERVAL=10

# Named next-hops — prefix must be NEXTHOP_
# Format: NEXTHOP_<label>=<ip>
# path-information is assigned by order (ddos1=1, ddos2=2, ...)
NEXTHOP_ddos1=192.168.5.2
NEXTHOP_ddos2=192.168.6.2
NEXTHOP_ddos3=192.168.1.2
NEXTHOP_ddos4=192.168.2.2


# RBTH — Remote Triggered Black Hole
# Community value to attach to /32 announcements
RBTH_COMMUNITY=65001:666
BLACKHOLE_isp1=65001:123:666
BLACKHOLE_isp2=65001:456:666


SIMPLE_COMMUNITY=65201:100
ROUTE_COMMUNITY=65201:100

IPV6_SELF=2a13:7440:1:2::1


# ── History ───────────────────────────────────────────────────────────────────
HISTORY_DAYS=90
 
# ── TLS (HAProxy self-signed cert subject) ────────────────────────────────────
TLS_CN=exabgp-manager
TLS_ORG=ExaBGP Manager
TLS_COUNTRY=TR
TLS_DAYS=3650
